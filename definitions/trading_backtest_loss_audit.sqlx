config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_backtest_loss_audit",
  description: "Auditoria de perdidas: identifica activos, estrategia, contexto y tipo de salida que deterioran el backtest estructural.",
  tags: ["trading", "backtest", "audit", "experiment", "daily"],
  dependencies: ["trading_structural_backtest_portfolio"]
}

WITH closed AS (
  SELECT * FROM ${ref("trading_structural_backtest_portfolio")}
)
SELECT
  ticker, asset_type, trading_group, strategy_version, result_label, historical_fear_regime, monetary_regime_proxy,
  political_regime_proxy, crypto_context_regime, earnings_event_status, company_lifecycle_context,
  COUNT(*) AS closed_trades,
  ROUND(SAFE_DIVIDE(COUNTIF(is_win), COUNT(*)) * 100, 2) AS win_rate_pct,
  ROUND(SUM(net_pnl_clp), 0) AS total_net_pnl_clp,
  ROUND(AVG(net_pnl_clp), 0) AS avg_net_pnl_clp,
  ROUND(APPROX_QUANTILES(net_pnl_clp, 100)[OFFSET(5)], 0) AS pnl_p05_clp,
  ARRAY_AGG(STRUCT(analysis_date, outcome_date, net_pnl_clp, result_label, contextual_setup_score) ORDER BY net_pnl_clp LIMIT 5) AS worst_trades,
  CASE WHEN SUM(net_pnl_clp) < 0 AND COUNT(*) >= 5 THEN "REVISAR_REGLA_O_EXCLUIR" WHEN SUM(net_pnl_clp) < 0 THEN "MUESTRA_BAJA" ELSE "SIN_ALERTA" END AS audit_recommendation,
  CURRENT_TIMESTAMP() AS calculated_at
FROM closed
GROUP BY ticker, asset_type, trading_group, strategy_version, result_label, historical_fear_regime, monetary_regime_proxy,
  political_regime_proxy, crypto_context_regime, earnings_event_status, company_lifecycle_context
