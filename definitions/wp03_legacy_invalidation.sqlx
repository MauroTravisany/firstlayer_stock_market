config {
  type: "table",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "wp03_legacy_invalidation",
  description: "Explicit WP-03 invalidation of frozen legacy result families whose fundamentals or earnings lineage was not point-in-time safe. The baseline registry snapshot is embedded from repository evidence so shadow validation never depends on a mutable or missing operational registry table.",
  tags: ["audit-grade", "governance", "legacy", "pit", "shadow", "wp03"],
  assertions: {
    nonNull: ["result_family", "source_table", "baseline_git_sha", "results_checksum", "wp03_classification", "promotion_eligible"],
    uniqueKey: ["result_family", "source_table"],
    rowConditions: [
      "wp03_classification = 'WP03_PIT_INVALIDATED'",
      "promotion_eligible = FALSE",
      "registry_resolution_mode = 'FROZEN_REPOSITORY_SNAPSHOT'"
    ]
  }
}

-- These rows are copied verbatim from the frozen WP-00 legacy registry.
-- They are intentionally repository-static: live shadow validation must not
-- depend on acciones_dataset.legacy_result_registry being materialized.
WITH frozen_affected_results AS (
  SELECT
    "CURRENT_SHADOW_SIGNALS" AS result_family,
    "trading_champion_challenger_signals" AS source_table,
    DATE("2019-01-01") AS date_start,
    DATE("2026-08-08") AS date_end,
    ["signals inherit legacy data and execution-model limitations"] AS known_defects,
    "b2e1b74c49e1a266feb79d6a4945b2e45053a099202454af723350772797b87c" AS results_checksum
  UNION ALL
  SELECT
    "DIRECTIONAL_V1",
    "trading_directional_strategy_backtest",
    DATE("2019-01-09"),
    DATE("2026-07-31"),
    ["financial available_at is not audit-grade", "raw/adjusted prices and corporate actions are not canonical", "gap-aware fills and locked final test are not implemented"],
    "a859f5de90a0009fcd95ed45aba758f3b806cb870ec3dc234035b3fb92dcc9b3"
  UNION ALL
  SELECT
    "DIRECTIONAL_V2",
    "trading_directional_strategy_backtest",
    DATE("2019-01-31"),
    DATE("2026-07-31"),
    ["financial available_at is not audit-grade", "raw/adjusted prices and corporate actions are not canonical", "gap-aware fills and locked final test are not implemented"],
    "e6432399a9dabeddfeb381d7168caf082d5cabdbc1995f93f38e078bacdc7763"
  UNION ALL
  SELECT
    "DIRECTIONAL_V3",
    "trading_directional_strategy_backtest",
    DATE("2019-01-31"),
    DATE("2026-07-29"),
    ["financial available_at is not audit-grade", "raw/adjusted prices and corporate actions are not canonical", "gap-aware fills and locked final test are not implemented"],
    "4b29478ee8b0d694becce51b464aa7c821cb48b724daa9c79676b8ae31c01aff"
  UNION ALL
  SELECT
    "DIRECTIONAL_V4",
    "trading_directional_strategy_backtest",
    DATE("2019-01-31"),
    DATE("2026-07-31"),
    ["financial available_at is not audit-grade", "raw/adjusted prices and corporate actions are not canonical", "gap-aware fills and locked final test are not implemented"],
    "6fc151773989e02c1b45c0b534d6487a0aa676225a6eda4ceed869f968073b8e"
  UNION ALL
  SELECT
    "STRATEGY_BRAIN_AUDITS",
    "trading_brain_ai_audits",
    DATE("2026-08-04"),
    DATE("2026-08-07"),
    ["candidate/run isolation and final-test separation await WP-06/WP-07", "legacy adaptive validation is not promotion evidence"],
    "0fa017b782cf89aac324fcdb158d8888edfd6713994bd9fb4f7e2c4bdca3504b"
  UNION ALL
  SELECT
    "STRATEGY_BRAIN_CANDIDATES",
    "trading_brain_weight_candidates",
    DATE("2026-08-04"),
    DATE("2026-08-08"),
    ["candidate/run isolation and final-test separation await WP-06/WP-07", "legacy adaptive validation is not promotion evidence"],
    "c2e35224d7b095758996071f6566165ff1e51c58b44f6af7fabfada7865125ca"
  UNION ALL
  SELECT
    "STRATEGY_BRAIN_CAPITAL_CURVE",
    "trading_brain_candidate_capital_curve",
    DATE("2019-01-31"),
    DATE("2026-07-31"),
    ["candidate/run isolation and final-test separation await WP-06/WP-07", "legacy adaptive validation is not promotion evidence"],
    "df3926b0b31d5336f6b9421cd9fb9231505cc008a964a64d37ce44d1fe6881d4"
  UNION ALL
  SELECT
    "STRATEGY_BRAIN_RUNS",
    "trading_brain_runs",
    DATE("2026-08-04"),
    DATE("2026-08-08"),
    ["candidate/run isolation and final-test separation await WP-06/WP-07", "legacy adaptive validation is not promotion evidence"],
    "7a9c93a277b470212632c022034b0a0a512a98881fc154b6ca6c78ef7aff4864"
  UNION ALL
  SELECT
    "STRATEGY_BRAIN_SUMMARY",
    "trading_brain_candidate_summary",
    DATE("2026-08-08"),
    DATE("2026-08-08"),
    ["candidate/run isolation and final-test separation await WP-06/WP-07", "legacy adaptive validation is not promotion evidence"],
    "9d670e907d0246c794b69a2cf6c765701ded3c232c043e4dc281397e3bc9297d"
)

SELECT
  result_family,
  source_table,
  date_start,
  date_end,
  "f7c27dbf6b4293e4ba2755a642d2f616d98b3844" AS baseline_git_sha,
  results_checksum,
  "docs/audit-grade/evidence/baseline_manifest.json" AS registry_source,
  "FROZEN_REPOSITORY_SNAPSHOT" AS registry_resolution_mode,
  TIMESTAMP("2026-08-08T15:17:29.785999Z") AS baseline_snapshot_as_of_utc,
  "WP03_PIT_INVALIDATED" AS wp03_classification,
  ARRAY_CONCAT(
    known_defects,
    [
      "legacy fundamentals could use period_end_date before market publication",
      "legacy financial revisions were mutable by fiscal period",
      "legacy earnings expected and reported values lacked independent available_at lineage"
    ]
  ) AS invalidation_reason,
  FALSE AS promotion_eligible,
  "REQUIRES_RECOMPUTE_ON_WP03_PIT_SNAPSHOT" AS remediation,
  CURRENT_TIMESTAMP() AS recorded_at
FROM frozen_affected_results
