config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v6_1_aggressive_backtest",
  description: "V6.1A: prueba aislada de umbral LONG menor. Mantiene una posicion a la vez, stops, objetivos, costos y sin conexion a Alpaca.",
  tags: ["trading", "backtest", "v6_1_aggressive", "experiment", "audit"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["profile_id", "ticker"] },
  assertions: { nonNull: ["aggressive_trade_id", "analysis_date", "outcome_date", "profile_id"], uniqueKey: ["aggressive_trade_id"] },
  dependencies: ["trading_paper_signals_active", "trading_price_features", "trading_v6_1_aggressive_config"]
}

-- One controlled change: lower the entry threshold. All exit and risk mechanics match
-- the directional baseline, so outcome differences are attributable to entry selectivity.
WITH RECURSIVE scored AS (
  SELECT
    s.*,
    c.profile_id,
    c.long_score_threshold,
    c.rationale AS profile_rationale,
    ROUND(5 + COALESCE(s.weighted_technical_score, 0) * 0.70 + COALESCE(s.macro_alignment_score, 0) * 0.85 + COALESCE(s.factor_alignment_score, 0) * 0.85 + COALESCE(s.earnings_event_score, 0) * 0.50 + IF(COALESCE(s.return_20d, 0) > 0, 0.55, -0.35) + IF(COALESCE(s.volume_vs_20d_avg, 0) >= 1.10, 0.35, 0) - GREATEST(COALESCE(s.market_fear_score, 50) - 70, 0) / 20, 2) AS long_score,
    ROUND(5 - COALESCE(s.weighted_technical_score, 0) * 0.75 - COALESCE(s.macro_alignment_score, 0) * 0.80 - COALESCE(s.factor_alignment_score, 0) * 0.80 - COALESCE(s.earnings_event_score, 0) * 0.45 + IF(COALESCE(s.return_5d, 0) < 0, 0.45, 0) + IF(COALESCE(s.return_20d, 0) < -0.02, 0.65, 0) + IF(COALESCE(s.volume_vs_20d_avg, 0) >= 1.10, 0.25, 0) + GREATEST(COALESCE(s.market_fear_score, 50) - 55, 0) / 22, 2) AS short_score,
    ROUND(LEAST(100.0, GREATEST(COALESCE(s.market_fear_score, 50), 0) + LEAST(COALESCE(s.atr_pct, 0) * 650, 25) + CASE WHEN s.days_to_earnings BETWEEN 0 AND 3 THEN 18 WHEN s.days_to_earnings BETWEEN 4 AND 7 THEN 8 ELSE 0 END + CASE WHEN s.external_macro_data_status != "OK" THEN 8 ELSE 0 END), 1) AS risk_score
  FROM ${ref("trading_paper_signals_active")} s
  JOIN ${ref("trading_v6_1_aggressive_config")} c
    ON c.ticker = s.ticker
   AND c.strategy_version = s.strategy_version
), qualified AS (
  SELECT
    *,
    TO_HEX(SHA256(CONCAT(paper_trade_id, "|V6_1_AGGRESSIVE"))) AS aggressive_trade_id
  FROM scored
  WHERE setup_type != "SIN_SETUP"
    AND strategy_filters_pass
    AND risk_reward_1 >= min_risk_reward
    AND long_score >= long_score_threshold
    AND long_score >= short_score + 0.75
    AND risk_score < 82
), future_candidates AS (
  SELECT
    t.aggressive_trade_id,
    t.max_holding_days,
    p.analysis_date AS path_date,
    p.day_low,
    p.day_high,
    p.day_close,
    CASE
      WHEN p.day_low <= t.stop_loss THEN "STOP_LOSS"
      WHEN p.day_high >= t.take_profit_2 THEN "TAKE_PROFIT_2"
      WHEN p.day_high >= t.take_profit_1 THEN "TAKE_PROFIT_1"
      ELSE NULL
    END AS event_type,
    CASE
      WHEN p.day_low <= t.stop_loss THEN t.stop_loss
      WHEN p.day_high >= t.take_profit_2 THEN t.take_profit_2
      WHEN p.day_high >= t.take_profit_1 THEN t.take_profit_1
      ELSE NULL
    END AS event_price,
    CASE
      WHEN p.day_low <= t.stop_loss THEN 1
      WHEN p.day_high >= t.take_profit_2 THEN 2
      WHEN p.day_high >= t.take_profit_1 THEN 3
      ELSE 9
    END AS event_priority
  FROM qualified t
  JOIN ${ref("trading_price_features")} p
    ON p.ticker = t.ticker
   AND p.signal_timestamp > t.signal_timestamp
   AND p.signal_timestamp <= DATETIME_ADD(t.signal_timestamp, INTERVAL 135 DAY)
), future_path AS (
  SELECT * EXCEPT (future_bar_number)
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY aggressive_trade_id ORDER BY path_date) AS future_bar_number
    FROM future_candidates
  )
  WHERE future_bar_number <= max_holding_days
), first_event AS (
  SELECT
    aggressive_trade_id,
    ARRAY_AGG(IF(event_type IS NOT NULL, STRUCT(path_date, event_type, event_price, event_priority), NULL) IGNORE NULLS ORDER BY path_date, event_priority LIMIT 1)[SAFE_OFFSET(0)] AS first_hit,
    ARRAY_AGG(STRUCT(path_date, day_close) ORDER BY path_date DESC LIMIT 1)[SAFE_OFFSET(0)] AS latest_seen,
    COUNT(*) AS future_days_seen
  FROM future_path
  GROUP BY aggressive_trade_id
), evaluated AS (
  SELECT
    t.*,
    fe.future_days_seen,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.path_date WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.path_date ELSE NULL END AS outcome_date,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.event_type WHEN fe.future_days_seen >= t.max_holding_days THEN "TIME_EXIT" ELSE "OPEN" END AS trade_status,
    CASE WHEN fe.first_hit.event_price IS NOT NULL THEN fe.first_hit.event_price WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.day_close ELSE NULL END AS exit_price
  FROM qualified t
  LEFT JOIN first_event fe USING (aggressive_trade_id)
), ranked_candidates AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY profile_id, analysis_date ORDER BY setup_score DESC, ticker) AS daily_rank
  FROM evaluated
  WHERE outcome_date IS NOT NULL
), daily_candidates AS (
  SELECT * EXCEPT (daily_rank)
  FROM ranked_candidates
  WHERE daily_rank = 1
), seed AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY profile_id ORDER BY analysis_date, ticker) AS seed_rank
  FROM daily_candidates
), sequential_trades AS (
  (SELECT * EXCEPT (seed_rank) FROM seed WHERE seed_rank = 1)
  UNION ALL
  (SELECT next_trade.*
   FROM sequential_trades previous_trade
   JOIN daily_candidates next_trade
     ON next_trade.profile_id = previous_trade.profile_id
    AND next_trade.analysis_date > previous_trade.outcome_date
   LEFT JOIN daily_candidates earlier_trade
     ON earlier_trade.profile_id = previous_trade.profile_id
    AND earlier_trade.analysis_date > previous_trade.outcome_date
    AND earlier_trade.analysis_date < next_trade.analysis_date
   WHERE earlier_trade.aggressive_trade_id IS NULL)
)

SELECT
  profile_id,
  ticker,
  strategy_version,
  profile_rationale,
  long_score_threshold,
  analysis_date,
  signal_timestamp,
  outcome_date,
  aggressive_trade_id,
  paper_trade_id AS baseline_paper_trade_id,
  asset_type,
  setup_score,
  long_score,
  short_score,
  risk_score,
  theoretical_entry_price,
  stop_loss,
  take_profit_1,
  take_profit_2,
  max_holding_days,
  estimated_roundtrip_cost_pct,
  position_notional_clp,
  future_days_seen,
  trade_status,
  exit_price,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price), 4) AS gross_return_pct,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100), 4) AS net_return_pct,
  ROUND(position_notional_clp * (SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100)), 0) AS net_pnl_clp,
  CASE WHEN trade_status IN ("TAKE_PROFIT_1", "TAKE_PROFIT_2") THEN TRUE WHEN trade_status = "TIME_EXIT" AND exit_price > theoretical_entry_price THEN TRUE ELSE FALSE END AS is_win,
  CASE WHEN analysis_date < DATE "2025-01-01" THEN "TRAINING_TO_2024" ELSE "OUT_OF_SAMPLE_2025_ONWARD" END AS evaluation_period,
  "V6_1_AGGRESSIVE_THRESHOLD_ONLY" AS portfolio_model,
  "Backtest only. One position at a time; never read by Paper Trading or Alpaca." AS safety_policy,
  CURRENT_TIMESTAMP() AS calculated_at
FROM sequential_trades
