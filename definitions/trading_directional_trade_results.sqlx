config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_directional_trade_results",
  description: "Backtest direccional V1-V4 con entrada en la primera apertura observable posterior a la senal, costos, stops, objetivos y horizonte por sesiones.",
  tags: ["trading", "paper", "directional", "results", "daily", "audited_entry"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["direction", "trade_status", "ticker"] },
  assertions: {
    nonNull: ["analysis_date", "entry_date", "ticker", "paper_trade_id", "direction"],
    uniqueKey: ["paper_trade_id"]
  },
  dependencies: ["trading_directional_signals", "trading_price_features"]
}

-- The signal uses completed daily information. A real order cannot fill at that
-- same close, so each backtest entry is moved to the next observable open.
WITH signals AS (
  SELECT *
  FROM ${ref("trading_directional_signals")}
  WHERE direction IN ("LONG", "SHORT_SIMULATED")
), entry_candidates AS (
  SELECT
    s.* EXCEPT (theoretical_entry_price, stop_loss, take_profit_1, take_profit_2, theoretical_quantity),
    s.theoretical_entry_price AS signal_close_entry_price,
    s.stop_loss AS signal_close_stop_loss,
    s.take_profit_1 AS signal_close_take_profit_1,
    s.take_profit_2 AS signal_close_take_profit_2,
    p.analysis_date AS entry_date,
    p.signal_timestamp AS entry_signal_timestamp,
    p.day_open AS entry_open_price,
    ROW_NUMBER() OVER (PARTITION BY s.paper_trade_id ORDER BY p.analysis_date) AS entry_rank
  FROM signals s
  JOIN ${ref("trading_price_features")} p
    ON p.ticker = s.ticker
   AND p.analysis_date > s.analysis_date
  WHERE p.day_open IS NOT NULL
), entry_levels AS (
  SELECT
    * EXCEPT (entry_rank),
    ROUND(
      entry_open_price * (
        1 + CASE WHEN direction = "LONG" THEN 1 ELSE -1 END * SAFE_DIVIDE(spread_bps + slippage_bps, 10000)
      ),
      4
    ) AS executable_entry_price,
    SAFE_DIVIDE(stop_distance_pct, 100) AS stop_distance_fraction,
    SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100) AS roundtrip_cost_fraction,
    CASE
      WHEN direction = "LONG" THEN SAFE_DIVIDE(
        SAFE_DIVIDE(signal_close_take_profit_1, signal_close_entry_price) - 1 - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100),
        SAFE_DIVIDE(stop_distance_pct, 100)
      )
      ELSE SAFE_DIVIDE(
        1 - SAFE_DIVIDE(signal_close_take_profit_1, signal_close_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100),
        SAFE_DIVIDE(stop_distance_pct, 100)
      )
    END AS take_profit_1_r_executable,
    CASE
      WHEN direction = "LONG" THEN SAFE_DIVIDE(
        SAFE_DIVIDE(signal_close_take_profit_2, signal_close_entry_price) - 1 - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100),
        SAFE_DIVIDE(stop_distance_pct, 100)
      )
      ELSE SAFE_DIVIDE(
        1 - SAFE_DIVIDE(signal_close_take_profit_2, signal_close_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100),
        SAFE_DIVIDE(stop_distance_pct, 100)
      )
    END AS take_profit_2_r_executable
  FROM entry_candidates
  WHERE entry_rank = 1
), trades AS (
  SELECT
    * EXCEPT (executable_entry_price),
    executable_entry_price AS theoretical_entry_price,
    ROUND(
      executable_entry_price * (1 + CASE WHEN direction = "LONG" THEN -1 ELSE 1 END * stop_distance_fraction),
      4
    ) AS stop_loss,
    ROUND(
      executable_entry_price * (
        1 + CASE WHEN direction = "LONG" THEN 1 ELSE -1 END * stop_distance_fraction * take_profit_1_r_executable
          + CASE WHEN direction = "LONG" THEN 1 ELSE -1 END * roundtrip_cost_fraction
      ),
      4
    ) AS take_profit_1,
    ROUND(
      executable_entry_price * (
        1 + CASE WHEN direction = "LONG" THEN 1 ELSE -1 END * stop_distance_fraction * take_profit_2_r_executable
          + CASE WHEN direction = "LONG" THEN 1 ELSE -1 END * roundtrip_cost_fraction
      ),
      4
    ) AS take_profit_2,
    ROUND(SAFE_DIVIDE(position_notional_clp, executable_entry_price * usd_clp_assumption), 6) AS theoretical_quantity
  FROM entry_levels
), future_candidates AS (
  SELECT
    t.paper_trade_id,
    t.max_holding_days,
    p.analysis_date AS path_date,
    p.day_low,
    p.day_high,
    p.day_close,
    CASE
      WHEN t.direction = "LONG" AND p.day_low <= t.stop_loss THEN "STOP_LOSS"
      WHEN t.direction = "LONG" AND p.day_high >= t.take_profit_2 THEN "TAKE_PROFIT_2"
      WHEN t.direction = "LONG" AND p.day_high >= t.take_profit_1 THEN "TAKE_PROFIT_1"
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_high >= t.stop_loss THEN "STOP_LOSS"
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_2 THEN "TAKE_PROFIT_2"
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_1 THEN "TAKE_PROFIT_1"
      ELSE NULL
    END AS event_type,
    CASE
      WHEN t.direction = "LONG" AND p.day_low <= t.stop_loss THEN t.stop_loss
      WHEN t.direction = "LONG" AND p.day_high >= t.take_profit_2 THEN t.take_profit_2
      WHEN t.direction = "LONG" AND p.day_high >= t.take_profit_1 THEN t.take_profit_1
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_high >= t.stop_loss THEN t.stop_loss
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_2 THEN t.take_profit_2
      WHEN t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_1 THEN t.take_profit_1
      ELSE NULL
    END AS event_price,
    CASE
      WHEN (t.direction = "LONG" AND p.day_low <= t.stop_loss) OR (t.direction = "SHORT_SIMULATED" AND p.day_high >= t.stop_loss) THEN 1
      WHEN (t.direction = "LONG" AND p.day_high >= t.take_profit_2) OR (t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_2) THEN 2
      WHEN (t.direction = "LONG" AND p.day_high >= t.take_profit_1) OR (t.direction = "SHORT_SIMULATED" AND p.day_low <= t.take_profit_1) THEN 3
      ELSE 9
    END AS event_priority
  FROM trades t
  JOIN ${ref("trading_price_features")} p
    ON p.ticker = t.ticker
   AND p.analysis_date >= t.entry_date
   AND p.analysis_date <= DATE_ADD(t.entry_date, INTERVAL 135 DAY)
), future_path AS (
  SELECT * EXCEPT (future_bar_number)
  FROM (
    SELECT
      future_candidates.*,
      ROW_NUMBER() OVER (PARTITION BY paper_trade_id ORDER BY path_date) AS future_bar_number
    FROM future_candidates
  )
  WHERE future_bar_number <= max_holding_days
), first_event AS (
  SELECT
    paper_trade_id,
    ARRAY_AGG(IF(event_type IS NOT NULL, STRUCT(path_date, event_type, event_price, event_priority), NULL) IGNORE NULLS ORDER BY path_date, event_priority LIMIT 1)[SAFE_OFFSET(0)] AS first_hit,
    ARRAY_AGG(STRUCT(path_date, day_close) ORDER BY path_date DESC LIMIT 1)[SAFE_OFFSET(0)] AS latest_seen,
    COUNT(*) AS future_days_seen
  FROM future_path
  GROUP BY paper_trade_id
), evaluated AS (
  SELECT
    t.*,
    fe.future_days_seen,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.path_date WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.path_date ELSE NULL END AS outcome_date,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.event_type WHEN fe.future_days_seen >= t.max_holding_days THEN "TIME_EXIT" ELSE "OPEN" END AS trade_status,
    CASE WHEN fe.first_hit.event_price IS NOT NULL THEN fe.first_hit.event_price WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.day_close ELSE NULL END AS exit_price
  FROM trades t
  LEFT JOIN first_event fe USING (paper_trade_id)
)

SELECT
  evaluated.* EXCEPT (calculated_at),
  ROUND(CASE WHEN direction = "SHORT_SIMULATED" THEN SAFE_DIVIDE(theoretical_entry_price - exit_price, theoretical_entry_price) ELSE SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) END, 4) AS gross_return_pct,
  ROUND(CASE WHEN direction = "SHORT_SIMULATED" THEN SAFE_DIVIDE(theoretical_entry_price - exit_price, theoretical_entry_price) ELSE SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) END - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100), 4) AS net_return_pct,
  ROUND(position_notional_clp * (CASE WHEN direction = "SHORT_SIMULATED" THEN SAFE_DIVIDE(theoretical_entry_price - exit_price, theoretical_entry_price) ELSE SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) END - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100)), 0) AS net_pnl_clp,
  CASE WHEN trade_status IN ("TAKE_PROFIT_1", "TAKE_PROFIT_2") THEN TRUE WHEN trade_status = "TIME_EXIT" AND ((direction = "LONG" AND exit_price > theoretical_entry_price) OR (direction = "SHORT_SIMULATED" AND exit_price < theoretical_entry_price)) THEN TRUE ELSE FALSE END AS is_win,
  CASE WHEN trade_status = "OPEN" THEN "ABIERTO" WHEN trade_status = "STOP_LOSS" THEN "PERDIDA" WHEN trade_status IN ("TAKE_PROFIT_1", "TAKE_PROFIT_2") THEN "GANANCIA" WHEN trade_status = "TIME_EXIT" AND ((direction = "LONG" AND exit_price > theoretical_entry_price) OR (direction = "SHORT_SIMULATED" AND exit_price < theoretical_entry_price)) THEN "GANANCIA_TIEMPO" WHEN trade_status = "TIME_EXIT" THEN "PERDIDA_TIEMPO" ELSE "NO_EVALUADO" END AS result_label,
  CASE
    WHEN external_macro_data_status = "EXTERNAL_MARKET_AND_NEWS_OK" THEN "NEWS_VALIDATED"
    ELSE "NEWS_NOT_HISTORICALLY_VALIDATED"
  END AS news_backtest_coverage,
  "NEXT_SESSION_OPEN_WITH_COSTS" AS backtest_entry_model,
  CURRENT_TIMESTAMP() AS calculated_at
FROM evaluated
