config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_contextual_backtest_results",
  description: "Backtest contextual de estrategias v1-v4 bajo variantes de ponderacion macro/fundamental/earnings.",
  tags: ["trading", "paper", "backtest", "context", "daily", "portfolio", "valuation"],
  bigquery: {
    partitionBy: "analysis_date",
    clusterBy: ["variant_id", "strategy_version", "trade_status"]
  },
  assertions: {
    nonNull: ["analysis_date", "ticker", "strategy_version", "variant_id"],
    uniqueKey: ["contextual_trade_id"]
  },
  dependencies: ["trading_paper_signals", "trading_historical_context", "trading_backtest_context_variants"]
}

WITH signals AS (
  SELECT *
  FROM ${ref("trading_paper_signals")}
),
scored AS (
  SELECT
    s.*,
    c.historical_fear_score,
    c.historical_fear_regime,
    c.monetary_regime_proxy,
    c.political_regime_proxy,
    c.crypto_context_regime,
    c.revenue_yoy,
    c.net_margin_asof,
    c.fcf_margin_asof,
    c.debt_to_equity_asof,
    c.company_lifecycle_context,
    c.company_status,
    c.status_group,
    c.classification,
    c.risk_level,
    c.technical_trend,
    c.fundamental_final_score,
    c.fundamental_quality_score,
    c.fundamental_valuation_score,
    c.fundamental_risk_score,
    c.context_similarity_key,
    v.variant_id,
    v.variant_name,
    v.variant_description,
    v.fear_weight,
    v.monetary_weight,
    v.earnings_weight,
    v.company_lifecycle_weight,
    v.quality_weight,
    v.valuation_state_weight,
    v.political_risk_weight,
    v.crypto_cycle_weight,
    v.min_trade_score_add,
    v.position_size_multiplier,
    CASE
      WHEN c.historical_fear_regime = "EXTREME_FEAR" THEN -1.50
      WHEN c.historical_fear_regime = "FEAR" THEN -0.75
      WHEN c.historical_fear_regime = "GREED" THEN -0.25
      WHEN c.historical_fear_regime = "LOW_FEAR" THEN 0.25
      ELSE 0.0
    END AS fear_context_component,
    CASE
      WHEN c.monetary_regime_proxy IN ("RATES_PRESSURE_REAL", "RATES_PRESSURE_PROXY") THEN -1.00
      WHEN c.monetary_regime_proxy = "TIGHTENING_OR_RISK_OFF_PROXY" THEN -0.55
      WHEN c.monetary_regime_proxy IN ("MONETARY_SUPPORT_REAL", "MONETARY_SUPPORT_PROXY") THEN 0.65
      ELSE 0.0
    END AS monetary_context_component,
    CASE
      WHEN c.company_lifecycle_context = "GROWTH_QUALITY" THEN 0.90
      WHEN c.company_lifecycle_context = "STABLE_QUALITY" THEN 0.55
      WHEN c.company_lifecycle_context = "GROWTH_FCF_PRESSURE" THEN -0.75
      WHEN c.company_lifecycle_context = "TURNAROUND_RISK" THEN -1.00
      ELSE 0.0
    END AS company_lifecycle_component,
    CASE
      WHEN c.fundamental_quality_score >= 3 THEN 0.65
      WHEN c.fundamental_quality_score <= -2 THEN -0.80
      WHEN c.risk_level = "ALTO" THEN -0.60
      ELSE 0.0
    END AS quality_component,
    CASE
      WHEN c.status_group = "COMPRA" OR c.classification = "BARATA" THEN 0.75
      WHEN c.status_group = "VENTA" OR c.classification IN ("CARA", "SOBREVALORADA") THEN -0.85
      WHEN c.status_group = "RIESGO" THEN -0.70
      ELSE 0.0
    END AS valuation_state_component,
    CASE
      WHEN c.political_regime_proxy IN ("SYSTEMIC_STRESS_REAL", "POLITICAL_OR_SYSTEMIC_STRESS_PROXY") THEN -0.90
      ELSE 0.0
    END AS political_risk_component,
    CASE
      WHEN s.asset_type = "CRYPTO" AND c.crypto_context_regime IN ("BTC_DOMINANTE", "ALTCOIN_ROTATION") THEN 0.95
      WHEN s.asset_type = "CRYPTO" AND c.crypto_context_regime = "CRYPTO_DEBIL" THEN -1.20
      WHEN s.ticker = "COIN" AND c.crypto_context_regime IN ("BTC_DOMINANTE", "ALTCOIN_ROTATION") THEN 0.65
      WHEN s.ticker = "COIN" AND c.crypto_context_regime = "CRYPTO_DEBIL" THEN -0.90
      ELSE 0.0
    END AS crypto_cycle_component
  FROM signals s
  JOIN ${ref("trading_historical_context")} c
    ON c.analysis_date = s.analysis_date
   AND c.signal_hour = s.signal_hour
   AND c.ticker = s.ticker
  CROSS JOIN ${ref("trading_backtest_context_variants")} v
),
variant_signals AS (
  SELECT
    *,
    ROUND(
      setup_score
      + fear_context_component * fear_weight
      + monetary_context_component * monetary_weight
      + earnings_event_score * earnings_weight
      + company_lifecycle_component * company_lifecycle_weight
      + quality_component * quality_weight
      + valuation_state_component * valuation_state_weight
      + political_risk_component * political_risk_weight
      + crypto_cycle_component * crypto_cycle_weight,
      2
    ) AS contextual_setup_score,
    ROUND(min_trade_score + min_trade_score_add, 2) AS contextual_min_trade_score,
    ROUND(position_notional_clp * position_size_multiplier, 0) AS contextual_position_notional_clp
  FROM scored
),
trades AS (
  SELECT
    *,
    TO_HEX(SHA256(CONCAT(paper_trade_id, "|", variant_id))) AS contextual_trade_id,
    CASE
      WHEN setup_type != "SIN_SETUP"
        AND contextual_setup_score >= contextual_min_trade_score
        AND strategy_filters_pass
        AND risk_reward_1 >= min_risk_reward
        THEN "TRADE_LONG"
      WHEN setup_type != "SIN_SETUP" AND contextual_setup_score >= min_watch_score THEN "VIGILAR"
      ELSE "SIN_TRADE"
    END AS contextual_signal
  FROM variant_signals
),
future_candidates AS (
  SELECT
    t.contextual_trade_id,
    t.max_holding_days,
    p.analysis_date AS path_date,
    p.day_low,
    p.day_high,
    p.day_close,
    CASE
      WHEN p.day_low <= t.stop_loss THEN "STOP_LOSS"
      WHEN p.day_high >= t.take_profit_2 THEN "TAKE_PROFIT_2"
      WHEN p.day_high >= t.take_profit_1 THEN "TAKE_PROFIT_1"
      ELSE NULL
    END AS event_type,
    CASE
      WHEN p.day_low <= t.stop_loss THEN t.stop_loss
      WHEN p.day_high >= t.take_profit_2 THEN t.take_profit_2
      WHEN p.day_high >= t.take_profit_1 THEN t.take_profit_1
      ELSE NULL
    END AS event_price,
    CASE
      WHEN p.day_low <= t.stop_loss THEN 1
      WHEN p.day_high >= t.take_profit_2 THEN 2
      WHEN p.day_high >= t.take_profit_1 THEN 3
      ELSE 9
    END AS event_priority
  FROM trades t
  JOIN ${ref("trading_price_features")} p
    ON p.ticker = t.ticker
   AND p.signal_timestamp > t.signal_timestamp
   -- El horizonte se cuenta en sesiones disponibles; 135 dias cubren el maximo de 45 sesiones.
   AND p.signal_timestamp <= DATETIME_ADD(t.signal_timestamp, INTERVAL 135 DAY)
  WHERE t.contextual_signal = "TRADE_LONG"
),
future_path AS (
  SELECT * EXCEPT(future_bar_number)
  FROM (
    SELECT
      future_candidates.*,
      ROW_NUMBER() OVER (PARTITION BY contextual_trade_id ORDER BY path_date) AS future_bar_number
    FROM future_candidates
  )
  WHERE future_bar_number <= max_holding_days
),
first_event AS (
  SELECT
    contextual_trade_id,
    ARRAY_AGG(
      IF(event_type IS NOT NULL, STRUCT(path_date, event_type, event_price, event_priority), NULL)
      IGNORE NULLS
      ORDER BY path_date, event_priority
      LIMIT 1
    )[SAFE_OFFSET(0)] AS first_hit,
    ARRAY_AGG(STRUCT(path_date, day_close) ORDER BY path_date DESC LIMIT 1)[SAFE_OFFSET(0)] AS latest_seen,
    COUNT(*) AS future_days_seen
  FROM future_path
  GROUP BY contextual_trade_id
),
evaluated AS (
  SELECT
    t.*,
    fe.future_days_seen,
    fe.first_hit,
    fe.latest_seen,
    CASE
      WHEN t.contextual_signal != "TRADE_LONG" THEN NULL
      WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.path_date
      WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.path_date
      ELSE NULL
    END AS outcome_date,
    CASE
      WHEN t.contextual_signal != "TRADE_LONG" THEN "NOT_OPENED"
      WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.event_type
      WHEN fe.future_days_seen >= t.max_holding_days THEN "TIME_EXIT"
      ELSE "OPEN"
    END AS trade_status,
    CASE
      WHEN t.contextual_signal != "TRADE_LONG" THEN NULL
      WHEN fe.first_hit.event_price IS NOT NULL THEN fe.first_hit.event_price
      WHEN fe.future_days_seen >= t.max_holding_days THEN fe.latest_seen.day_close
      ELSE NULL
    END AS exit_price
  FROM trades t
  LEFT JOIN first_event fe
    ON fe.contextual_trade_id = t.contextual_trade_id
)

SELECT
  analysis_date,
  signal_hour,
  signal_timestamp,
  outcome_date,
  ticker,
  asset_type,
  trading_group,
  trading_style,
  sector_profile,
  cycle_profile,
  strategy_version,
  strategy_name,
  variant_id,
  variant_name,
  contextual_trade_id,
  paper_trade_id,
  setup_type,
  paper_signal AS original_signal,
  contextual_signal,
  setup_score AS original_setup_score,
  contextual_setup_score,
  min_trade_score AS original_min_trade_score,
  contextual_min_trade_score,
  weighted_technical_score,
  macro_alignment_score,
  factor_alignment_score,
  earnings_event_score,
  historical_fear_score,
  historical_fear_regime,
  market_fear_score,
  market_fear_regime,
  monetary_regime_proxy,
  political_regime_proxy,
  crypto_context_regime,
  macro_regime,
  earnings_event_status,
  earnings_date,
  days_to_earnings,
  company_lifecycle_context,
  revenue_yoy,
  net_margin_asof,
  fcf_margin_asof,
  company_status,
  status_group,
  classification,
  risk_level,
  technical_trend,
  context_similarity_key,
  fear_context_component,
  monetary_context_component,
  company_lifecycle_component,
  quality_component,
  valuation_state_component,
  political_risk_component,
  crypto_cycle_component,
  close_price,
  theoretical_entry_price,
  stop_loss,
  take_profit_1,
  take_profit_2,
  risk_reward_1,
  risk_reward_2,
  max_holding_days,
  estimated_roundtrip_cost_pct,
  stop_distance_pct,
  position_notional_clp AS original_position_notional_clp,
  contextual_position_notional_clp,
  trade_status,
  exit_price,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price), 4) AS gross_return_pct,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100), 4) AS net_return_pct,
  ROUND(
    contextual_position_notional_clp * (
      SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - SAFE_DIVIDE(estimated_roundtrip_cost_pct, 100)
    ),
    0
  ) AS net_pnl_clp,
  CASE
    WHEN trade_status IN ("TAKE_PROFIT_1", "TAKE_PROFIT_2") THEN TRUE
    WHEN trade_status = "TIME_EXIT" AND exit_price > theoretical_entry_price THEN TRUE
    ELSE FALSE
  END AS is_win,
  CASE
    WHEN contextual_signal != "TRADE_LONG" THEN "NO_ABIERTO"
    WHEN trade_status = "OPEN" THEN "ABIERTO"
    WHEN trade_status = "STOP_LOSS" THEN "PERDIDA"
    WHEN trade_status IN ("TAKE_PROFIT_1", "TAKE_PROFIT_2") THEN "GANANCIA"
    WHEN trade_status = "TIME_EXIT" AND exit_price > theoretical_entry_price THEN "GANANCIA_TIEMPO"
    WHEN trade_status = "TIME_EXIT" THEN "PERDIDA_TIEMPO"
    ELSE "NO_EVALUADO"
  END AS result_label,
  CONCAT(
    "variant=", variant_id,
    "; context=", context_similarity_key,
    "; score_original=", CAST(setup_score AS STRING),
    "; score_contextual=", CAST(contextual_setup_score AS STRING),
    "; miedo=", historical_fear_regime,
    "; monetario=", monetary_regime_proxy,
    "; compania=", company_lifecycle_context,
    "; earnings=", earnings_event_status
  ) AS backtest_reason,
  CURRENT_TIMESTAMP() AS calculated_at
FROM evaluated
