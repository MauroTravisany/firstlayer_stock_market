config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v6_profile_summary",
  description: "Resumen V6 separado entre calibracion hasta 2024 y prueba fuera de muestra 2025+. No autoriza Paper Trading.",
  tags: ["trading", "backtest", "v6", "experiment", "audit"],
  assertions: { nonNull: ["evaluation_period"], uniqueKey: ["evaluation_period"] },
  dependencies: ["trading_v6_profile_backtest"]
}

WITH period_trades AS (
  SELECT "TRAINING_TO_2024" AS evaluation_period, *
  FROM ${ref("trading_v6_profile_backtest")}
  WHERE analysis_date < DATE "2025-01-01"
  UNION ALL
  SELECT "OUT_OF_SAMPLE_2025_ONWARD", *
  FROM ${ref("trading_v6_profile_backtest")}
  WHERE analysis_date >= DATE "2025-01-01"
), equity_curve AS (
  SELECT
    *,
    10000000.0 + SUM(net_pnl_clp) OVER (
      PARTITION BY evaluation_period
      ORDER BY outcome_date, analysis_date, ticker
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS equity_clp
  FROM period_trades
), equity_with_peak AS (
  SELECT
    *,
    MAX(equity_clp) OVER (
      PARTITION BY evaluation_period
      ORDER BY outcome_date, analysis_date, ticker
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS running_peak_clp
  FROM equity_curve
)

SELECT
  evaluation_period,
  COUNT(*) AS closed_trades,
  COUNT(DISTINCT ticker) AS ticker_count,
  COUNTIF(is_win) AS wins,
  COUNTIF(NOT is_win) AS losses,
  ROUND(SAFE_DIVIDE(COUNTIF(is_win), COUNT(*)) * 100, 2) AS win_rate_pct,
  ROUND(SUM(net_pnl_clp), 0) AS net_pnl_clp,
  ROUND(SAFE_DIVIDE(SUM(IF(net_pnl_clp > 0, net_pnl_clp, 0)), ABS(SUM(IF(net_pnl_clp < 0, net_pnl_clp, 0)))), 3) AS profit_factor,
  ROUND(MAX(running_peak_clp - equity_clp), 0) AS max_drawdown_clp,
  ROUND(MAX(SAFE_DIVIDE(running_peak_clp - equity_clp, running_peak_clp)) * 100, 2) AS max_drawdown_pct,
  CASE
    WHEN evaluation_period = "OUT_OF_SAMPLE_2025_ONWARD" AND COUNT(*) >= 15 AND SUM(net_pnl_clp) > 0 AND SAFE_DIVIDE(SUM(IF(net_pnl_clp > 0, net_pnl_clp, 0)), ABS(SUM(IF(net_pnl_clp < 0, net_pnl_clp, 0)))) >= 1.10 THEN "REVIEW_REQUIRED_BEFORE_ANY_PROMOTION"
    ELSE "BACKTEST_ONLY"
  END AS promotion_status,
  "V6 conserva el perfil elegido antes de 2025. No cambia estrategias activas ni opera en Alpaca." AS safety_policy,
  CURRENT_TIMESTAMP() AS calculated_at
FROM equity_with_peak
GROUP BY evaluation_period
