config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_brain_candidate_summary",
  description: "Resultados auditables por corrida, candidato y estrategia del cerebro. Solo utiliza PnL neto de costos y permanece en modo backtest-only.",
  tags: ["trading", "backtest", "brain", "audit", "daily"],
  bigquery: {
    clusterBy: ["run_id", "strategy_version", "evaluation_split"]
  },
  dependencies: ["trading_contextual_backtest_results"]
}

WITH closed AS (
  SELECT
    r.variant_id AS candidate_id,
    c.run_id,
    c.formula_version,
    c.candidate_status,
    c.training_start,
    c.training_end,
    c.validation_start,
    c.validation_end,
    r.strategy_version,
    r.ticker,
    r.analysis_date,
    r.net_pnl_clp,
    r.net_return_pct,
    r.is_win
  FROM ${ref("trading_contextual_backtest_results")} r
  JOIN `stocks-437902.acciones_dataset.trading_brain_weight_candidates` c
    ON r.variant_id = c.candidate_id
  WHERE r.contextual_signal = "TRADE_LONG"
    AND r.trade_status != "OPEN"
    AND r.outcome_date IS NOT NULL
),
labeled AS (
  SELECT
    *,
    CASE
      WHEN analysis_date BETWEEN training_start AND training_end THEN "TRAIN"
      WHEN analysis_date BETWEEN validation_start AND validation_end THEN "VALIDATION"
      ELSE "OUTSIDE_WINDOW"
    END AS evaluation_split
  FROM closed
),
aggregated AS (
  SELECT
    run_id,
    formula_version,
    candidate_id,
    candidate_status,
    strategy_version,
    evaluation_split,
    COUNT(*) AS closed_trades,
    COUNT(DISTINCT ticker) AS ticker_count,
    COUNTIF(is_win) AS wins,
    COUNTIF(NOT is_win) AS losses,
    ROUND(SAFE_DIVIDE(COUNTIF(is_win), COUNT(*)) * 100, 2) AS win_rate_pct,
    ROUND(SUM(net_pnl_clp), 0) AS net_pnl_clp,
    ROUND(AVG(net_pnl_clp), 0) AS avg_net_pnl_clp,
    ROUND(SAFE_DIVIDE(SUM(IF(net_pnl_clp > 0, net_pnl_clp, 0)), ABS(SUM(IF(net_pnl_clp < 0, net_pnl_clp, 0)))), 3) AS profit_factor,
    ROUND(APPROX_QUANTILES(net_pnl_clp, 100)[OFFSET(5)], 0) AS pnl_p05_clp,
    ROUND(AVG(net_return_pct) * 100, 2) AS avg_net_return_pct,
    CURRENT_TIMESTAMP() AS calculated_at
  FROM labeled
  WHERE evaluation_split IN ("TRAIN", "VALIDATION")
  GROUP BY run_id, formula_version, candidate_id, candidate_status, strategy_version, evaluation_split
)

SELECT
  *,
  CASE
    WHEN closed_trades < 20 THEN "INSUFFICIENT_DATA"
    WHEN net_pnl_clp > 0 AND profit_factor >= 1.10 AND win_rate_pct >= 45 AND pnl_p05_clp > -250000 THEN "ELIGIBLE_FOR_REVIEW"
    ELSE "REJECTED_BY_GUARDRAIL"
  END AS mechanical_verdict
FROM aggregated
