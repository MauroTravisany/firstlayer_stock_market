config {
  type: "operations",
  hasOutput: true,
  schema: dataform.projectConfig.vars.auditDataset,
  name: "market_session_calendar",
  description: "Versioned XNYS, FX_24_5 and CRYPTO_24_7 sessions generated by the reviewed WP-04 calendar implementation.",
  tags: ["audit-grade", "calendar", "sessions", "wp04"]
}

CREATE TABLE IF NOT EXISTS ${self()} (
  session_id STRING NOT NULL,
  exchange STRING NOT NULL,
  asset_type STRING NOT NULL,
  session_date DATE NOT NULL,
  open_utc TIMESTAMP NOT NULL,
  close_utc TIMESTAMP NOT NULL,
  session_status STRING NOT NULL,
  timezone STRING NOT NULL,
  expected_15m_bars INT64 NOT NULL,
  expected_1h_bars INT64 NOT NULL,
  calendar_version STRING NOT NULL,
  calendar_hash STRING NOT NULL,
  available_at TIMESTAMP NOT NULL,
  ingested_at TIMESTAMP NOT NULL
)
PARTITION BY session_date
CLUSTER BY exchange, asset_type;
