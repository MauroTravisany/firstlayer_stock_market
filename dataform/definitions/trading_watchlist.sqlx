config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_watchlist",
  description: "Lista acotada de activos para paper trading diario. No ejecuta dinero real.",
  tags: ["trading", "paper", "daily"]
}

SELECT *
FROM UNNEST([
  STRUCT("AAPL" AS ticker, "STOCK" AS asset_type, "mega_cap_stock" AS trading_group, 5.0 AS spread_bps, 5.0 AS slippage_bps, TRUE AS enabled),
  STRUCT("MSFT", "STOCK", "mega_cap_stock", 5.0, 5.0, TRUE),
  STRUCT("NVDA", "STOCK", "high_beta_stock", 8.0, 8.0, TRUE),
  STRUCT("META", "STOCK", "mega_cap_stock", 6.0, 6.0, TRUE),
  STRUCT("COIN", "STOCK", "crypto_sensitive_stock", 18.0, 12.0, TRUE),
  STRUCT("BTC-USD", "CRYPTO", "crypto_major", 12.0, 8.0, TRUE),
  STRUCT("ETH-USD", "CRYPTO", "crypto_major", 14.0, 10.0, TRUE)
])
