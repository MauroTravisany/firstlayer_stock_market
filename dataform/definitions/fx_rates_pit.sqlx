config {
  type: "table",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "fx_rates_pit",
  description: "Historical USD/CLP observed-dollar reference rates sourced directly from the official Banco Central de Chile BDE series.",
  tags: ["audit-grade", "fx", "pit", "shadow", "wp04"],
  bigquery: { partitionBy: "rate_date", clusterBy: ["base_currency", "quote_currency"] },
  assertions: {
    nonNull: ["fx_rate_id", "rate_date", "base_currency", "quote_currency", "rate", "source_price_id", "provider", "available_at", "ingested_at", "quality_status", "data_snapshot_id", "production_change_allowed"],
    uniqueKey: ["rate_date", "base_currency", "quote_currency"]
  }
}

WITH latest_reference_revision AS (
  SELECT * EXCEPT (rn)
  FROM (
    SELECT
      r.*,
      DATE(r.bar_start, r.source_timezone) AS rate_date,
      ROW_NUMBER() OVER (
        PARTITION BY DATE(r.bar_start, r.source_timezone)
        ORDER BY r.available_at DESC, r.ingested_at DESC, r.raw_revision_id DESC
      ) AS rn
    FROM ${ref("market_price_raw")} r
    WHERE r.provider = "BCCH_BDE"
      AND r.provider_symbol = "F073.TCO.PRE.Z.D"
      AND r.ticker = ${JSON.stringify(dataform.projectConfig.vars.usdClpTicker || "CLP=X")}
      AND r.asset_type = "FX"
      AND r.exchange = "FX_24_5"
      AND r.source_interval = "1d"
      AND r.source_timezone = "America/Santiago"
      AND r.quality_status = "RAW_REFERENCE_RATE_VALIDATED"
      AND r.open IS NULL
      AND r.high IS NULL
      AND r.low IS NULL
      AND r.close IS NULL
      AND r.volume IS NULL
      AND r.adjusted_close > 0
      AND r.available_at >= r.bar_end
  )
  WHERE rn = 1
)

SELECT
  TO_HEX(SHA256(CONCAT(raw_revision_id, "|USD|CLP"))) AS fx_rate_id,
  rate_date,
  "USD" AS base_currency,
  "CLP" AS quote_currency,
  adjusted_close AS rate,
  raw_revision_id AS source_price_id,
  provider,
  available_at,
  ingested_at,
  "OFFICIAL_REFERENCE_RATE" AS quality_status,
  TO_HEX(SHA256(CONCAT(raw_revision_id, "|", CAST(rate_date AS STRING), "|USD|CLP"))) AS data_snapshot_id,
  FALSE AS production_change_allowed
FROM latest_reference_revision
