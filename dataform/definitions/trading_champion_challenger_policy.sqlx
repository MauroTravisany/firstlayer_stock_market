config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_champion_challenger_policy",
  description: "Politica conservadora por activo para Paper Trading. Ningun perfil se ejecuta hasta superar entrenamiento y validacion independientes con muestra suficiente.",
  tags: ["trading", "paper", "daily", "champion", "governance"],
  assertions: { nonNull: ["ticker", "champion_strategy_version", "execution_mode"], uniqueKey: ["ticker"] }
}

SELECT * FROM UNNEST([
  STRUCT("AAPL" AS ticker, "TECH_MEGACAP" AS asset_rule_profile, "v2" AS champion_strategy_version, "SHADOW_ONLY" AS execution_mode, "V2 es positivo en entrenamiento, pero solo acumula cuatro validaciones en 2025; permanece en sombra hasta alcanzar muestra suficiente." AS policy_reason),
  STRUCT("META", "DIGITAL_ADVERTISING_AI", "v2", "SHADOW_ONLY", "V2 tiene evidencia limitada: ocho cierres de entrenamiento y dos de validacion; permanece en sombra hasta una validacion independiente suficiente."),
  STRUCT("NVDA", "SEMICONDUCTOR_AI", "v2", "SHADOW_ONLY", "V2 no valido una ventaja robusta en semiconductores; se mide sin abrir orden."),
  STRUCT("COIN", "CRYPTO_LINKED_EQUITY", "v2", "SHADOW_ONLY", "La muestra de COIN es insuficiente para ejecutar; se conserva como comparador."),
  STRUCT("BTC-USD", "CRYPTO_BTC", "v2", "SHADOW_ONLY", "La evidencia diaria de BTC no alcanza para promover V2 a ejecucion."),
  STRUCT("ETH-USD", "CRYPTO_ETH", "v2", "SHADOW_ONLY", "La evidencia diaria de ETH no alcanza para promover V2 a ejecucion.")
])
