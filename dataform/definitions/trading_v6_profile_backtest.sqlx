config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v6_profile_backtest",
  description: "V6: cartera aislada por lotes sin solapamiento que usa la logica V2 solo en perfiles seleccionados antes de 2025. No alimenta Paper Trading.",
  tags: ["trading", "backtest", "v6", "experiment"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["asset_rule_profile", "ticker"] },
  assertions: { nonNull: ["analysis_date", "outcome_date", "v6_trade_id", "asset_rule_profile"], uniqueKey: ["v6_trade_id"] },
  dependencies: ["trading_directional_trade_results", "trading_watchlist", "trading_v6_profile_selection"]
}

-- V6 reuses V2's price, stop and cost model. Its only new hypothesis is a
-- profile gate selected before the out-of-sample period begins.
WITH eligible AS (
  SELECT
    r.*,
    CASE
      WHEN r.asset_type = "CRYPTO" AND r.cycle_profile LIKE "%BTC%" THEN "CRYPTO_BTC"
      WHEN r.asset_type = "CRYPTO" THEN "CRYPTO_ETH"
      WHEN r.trading_group = "crypto_sensitive_stock" THEN "CRYPTO_LINKED_EQUITY"
      WHEN r.trading_group = "high_beta_stock" THEN "SEMICONDUCTOR_AI"
      WHEN r.sector_profile = "Digital advertising/AI" THEN "DIGITAL_ADVERTISING_AI"
      WHEN r.trading_group = "mega_cap_stock" THEN "TECH_MEGACAP"
      ELSE "DEFENSIVE_OR_ETF"
    END AS asset_rule_profile
  FROM ${ref("trading_directional_trade_results")} r
  JOIN ${ref("trading_watchlist")} w
    ON w.ticker = r.ticker
   AND w.asset_type = r.asset_type
  WHERE r.strategy_version = "v2"
    AND r.direction = "LONG"
    AND r.outcome_date IS NOT NULL
    AND w.enabled
), candidates AS (
  SELECT
    e.*,
    TO_HEX(SHA256(CONCAT(e.paper_trade_id, "|v6-profile-gate"))) AS v6_trade_id,
    ROW_NUMBER() OVER (
      PARTITION BY e.analysis_date
      ORDER BY e.setup_score DESC, e.ticker
    ) AS daily_rank
  FROM eligible e
  JOIN ${ref("trading_v6_profile_selection")} s
    ON s.asset_rule_profile = e.asset_rule_profile
   AND s.selection_status = "SELECTED_FOR_V6"
), daily_candidates AS (
  SELECT * EXCEPT (daily_rank)
  FROM candidates
  WHERE daily_rank = 1
), batched_candidates AS (
  SELECT
    *,
    DIV(DATE_DIFF(analysis_date, DATE "2019-01-01", DAY), 16) AS batch_number,
    MOD(DATE_DIFF(analysis_date, DATE "2019-01-01", DAY), 16) AS batch_day_offset
  FROM daily_candidates
), batch_entry_days AS (
  SELECT batch_number, MIN(analysis_date) AS batch_start_date
  FROM batched_candidates
  WHERE batch_day_offset < 8
  GROUP BY batch_number
)

SELECT
  c.*,
  b.batch_start_date,
  "V6_V2_PROFILE_GATE_BATCHED" AS portfolio_model,
  "V2 rules plus pre-2025 profile selection; 2025+ is out-of-sample only." AS experiment_policy,
  CURRENT_TIMESTAMP() AS backtest_calculated_at
FROM batch_entry_days b
JOIN batched_candidates c
  ON c.batch_number = b.batch_number
 AND c.analysis_date = b.batch_start_date
