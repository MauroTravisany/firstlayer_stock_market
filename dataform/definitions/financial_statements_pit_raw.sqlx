config {
  type: "operations",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "financial_statements_pit_raw",
  description: "Creates the append-only SEC filing revision store used by WP-03.",
  tags: ["audit-grade", "pit", "financials", "wp03"]
}

CREATE TABLE IF NOT EXISTS ${self()} (
  revision_id STRING NOT NULL,
  ticker STRING NOT NULL,
  cik STRING,
  form_type STRING,
  accession_number STRING,
  filing_date DATE,
  source_published_at TIMESTAMP,
  available_at TIMESTAMP,
  period_end_date DATE,
  fiscal_year INT64,
  fiscal_quarter INT64,
  currency STRING,
  revenue FLOAT64,
  gross_profit FLOAT64,
  operating_income FLOAT64,
  net_income FLOAT64,
  eps_basic FLOAT64,
  eps_diluted FLOAT64,
  total_assets FLOAT64,
  total_liabilities FLOAT64,
  total_debt FLOAT64,
  debt_current FLOAT64,
  debt_noncurrent FLOAT64,
  cash_and_equivalents FLOAT64,
  shares_outstanding FLOAT64,
  shareholders_equity FLOAT64,
  operating_cash_flow FLOAT64,
  free_cash_flow FLOAT64,
  source STRING,
  source_url STRING,
  backtest_eligible BOOL NOT NULL,
  eligibility_reason STRING NOT NULL,
  loaded_at TIMESTAMP NOT NULL
)
CLUSTER BY ticker, fiscal_year, fiscal_quarter;
