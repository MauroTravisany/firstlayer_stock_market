config {
  type: "table",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "portfolio_valuation_pit_shadow",
  description: "Shadow-only valuation rebuilt from prior-session price and SEC filing facts available at each signal timestamp. Same-day close, forward ratios, cross-currency arithmetic and non-additive annual EPS derivations are excluded.",
  tags: ["audit-grade", "pit", "financials", "valuation", "shadow", "wp03"],
  bigquery: {
    partitionBy: "analysis_date",
    clusterBy: ["ticker", "classification_pit"]
  },
  assertions: {
    nonNull: ["analysis_date", "signal_hour", "signal_timestamp_utc", "ticker", "classification_pit", "promotion_mode", "production_change_allowed"],
    uniqueKey: ["analysis_date", "signal_hour", "ticker"],
    rowConditions: [
      "valuation_price_available_at IS NULL OR valuation_price_available_at <= signal_timestamp_utc",
      "latest_financial_available_at IS NULL OR latest_financial_available_at <= signal_timestamp_utc",
      "promotion_mode = 'SHADOW_ONLY'",
      "production_change_allowed = FALSE"
    ]
  },
  dependencies: ["financial_ttm_pit", "trading_price_features", "asset_profile", "valuation_model_profile"]
}

WITH price_basis AS (
  SELECT
    p.*,
    TIMESTAMP(p.signal_timestamp, "UTC") AS signal_timestamp_utc,
    LAG(p.analysis_date) OVER (
      PARTITION BY p.ticker
      ORDER BY p.analysis_date, p.signal_hour
    ) AS valuation_price_session_date
  FROM ${ref("trading_price_features")} p
),
base AS (
  SELECT
    p.analysis_date,
    p.signal_hour,
    p.signal_timestamp,
    p.signal_timestamp_utc,
    p.ticker,
    p.asset_type,
    p.previous_close AS valuation_price,
    p.valuation_price_session_date,
    CASE
      WHEN p.valuation_price_session_date IS NULL THEN NULL
      ELSE TIMESTAMP(
        DATETIME(p.valuation_price_session_date, TIME "23:59:59"),
        "UTC"
      )
    END AS valuation_price_available_at,
    "PREVIOUS_OBSERVED_SESSION_CLOSE_CONSERVATIVE_EOD_UTC" AS valuation_price_basis,
    ap.sector,
    ap.industry,
    ap.peer_group,
    COALESCE(vm.valuation_model, fallback.valuation_model) AS valuation_model,
    t.currency AS reporting_currency,
    t.latest_financial_available_at,
    t.ttm_revision_ids,
    t.ttm_revision_numbers,
    t.ttm_restatement_flags,
    t.ttm_mapping_versions,
    t.ttm_value_basis,
    t.ttm_derivation_lineage_json,
    t.ttm_complete,
    t.quarter_ordinal_span,
    t.currency_count,
    t.revenue_ttm,
    t.net_income_ttm,
    t.total_debt_latest,
    t.cash_and_equivalents_latest,
    t.shares_outstanding_latest,
    t.shareholders_equity_latest,
    t.net_margin_ttm,
    t.gross_margin_ttm,
    t.operating_margin_ttm,
    CASE
      WHEN t.currency = "USD"
        AND p.previous_close > 0
        AND t.shares_outstanding_latest > 0
        THEN SAFE_MULTIPLY(p.previous_close, t.shares_outstanding_latest)
      ELSE NULL
    END AS market_cap_pit,
    CASE
      WHEN t.currency = "USD"
        AND p.previous_close > 0
        AND t.shares_outstanding_latest > 0
        AND t.net_income_ttm > 0
        THEN SAFE_DIVIDE(
          SAFE_MULTIPLY(p.previous_close, t.shares_outstanding_latest),
          t.net_income_ttm
        )
      ELSE NULL
    END AS pe_ttm_pit,
    CASE
      WHEN t.currency = "USD"
        AND p.previous_close > 0
        AND t.shares_outstanding_latest > 0
        AND t.revenue_ttm > 0
        THEN SAFE_DIVIDE(
          SAFE_MULTIPLY(p.previous_close, t.shares_outstanding_latest),
          t.revenue_ttm
        )
      ELSE NULL
    END AS price_to_sales_ttm_pit,
    CASE
      WHEN t.currency = "USD"
        AND p.previous_close > 0
        AND t.shares_outstanding_latest > 0
        AND t.shareholders_equity_latest > 0
        THEN SAFE_DIVIDE(
          SAFE_MULTIPLY(p.previous_close, t.shares_outstanding_latest),
          t.shareholders_equity_latest
        )
      ELSE NULL
    END AS price_to_book_pit,
    COALESCE(vm.pe_cheap, fallback.pe_cheap) AS pe_cheap,
    COALESCE(vm.pe_fair, fallback.pe_fair) AS pe_fair,
    COALESCE(vm.pe_expensive, fallback.pe_expensive) AS pe_expensive,
    COALESCE(vm.pe_extreme, fallback.pe_extreme) AS pe_extreme,
    COALESCE(vm.pe_weight, fallback.pe_weight) AS pe_weight,
    COALESCE(vm.ps_cheap, fallback.ps_cheap) AS ps_cheap,
    COALESCE(vm.ps_fair, fallback.ps_fair) AS ps_fair,
    COALESCE(vm.ps_expensive, fallback.ps_expensive) AS ps_expensive,
    COALESCE(vm.ps_extreme, fallback.ps_extreme) AS ps_extreme,
    COALESCE(vm.ps_weight, fallback.ps_weight) AS ps_weight,
    COALESCE(vm.pb_cheap, fallback.pb_cheap) AS pb_cheap,
    COALESCE(vm.pb_fair, fallback.pb_fair) AS pb_fair,
    COALESCE(vm.pb_expensive, fallback.pb_expensive) AS pb_expensive,
    COALESCE(vm.pb_extreme, fallback.pb_extreme) AS pb_extreme,
    COALESCE(vm.pb_weight, fallback.pb_weight) AS pb_weight,
    COALESCE(vm.profit_margin_good, fallback.profit_margin_good) AS profit_margin_good,
    COALESCE(vm.profit_margin_bad, fallback.profit_margin_bad) AS profit_margin_bad,
    COALESCE(vm.profit_margin_weight, fallback.profit_margin_weight) AS profit_margin_weight,
    COALESCE(vm.operating_margin_good, fallback.operating_margin_good) AS operating_margin_good,
    COALESCE(vm.operating_margin_bad, fallback.operating_margin_bad) AS operating_margin_bad,
    COALESCE(vm.operating_margin_weight, fallback.operating_margin_weight) AS operating_margin_weight
  FROM price_basis p
  LEFT JOIN ${ref("financial_ttm_pit")} t
    USING (analysis_date, signal_hour, ticker)
  LEFT JOIN ${ref("asset_profile")} ap
    ON ap.ticker = p.ticker
  LEFT JOIN ${ref("valuation_model_profile")} vm
    ON vm.peer_group = ap.peer_group
  LEFT JOIN ${ref("valuation_model_profile")} fallback
    ON fallback.peer_group = "default_stock"
),
scored AS (
  SELECT
    *,
    CASE
      WHEN asset_type IN ("ETF", "CRYPTO")
        OR NOT COALESCE(ttm_complete, FALSE)
        OR pe_ttm_pit IS NULL
        OR pe_weight = 0 THEN 0
      WHEN pe_ttm_pit <= pe_cheap THEN 1.5 * pe_weight
      WHEN pe_ttm_pit <= pe_fair THEN 0.25 * pe_weight
      WHEN pe_ttm_pit <= pe_expensive THEN -0.5 * pe_weight
      WHEN pe_ttm_pit <= pe_extreme THEN -1.0 * pe_weight
      ELSE -2.0 * pe_weight
    END AS pe_score_pit,
    CASE
      WHEN asset_type IN ("ETF", "CRYPTO")
        OR NOT COALESCE(ttm_complete, FALSE)
        OR price_to_sales_ttm_pit IS NULL
        OR ps_weight = 0 THEN 0
      WHEN price_to_sales_ttm_pit <= ps_cheap THEN 1.5 * ps_weight
      WHEN price_to_sales_ttm_pit <= ps_fair THEN 0.25 * ps_weight
      WHEN price_to_sales_ttm_pit <= ps_expensive THEN -0.75 * ps_weight
      WHEN price_to_sales_ttm_pit <= ps_extreme THEN -1.5 * ps_weight
      ELSE -2.25 * ps_weight
    END AS ps_score_pit,
    CASE
      WHEN asset_type IN ("ETF", "CRYPTO")
        OR price_to_book_pit IS NULL
        OR pb_weight = 0 THEN 0
      WHEN price_to_book_pit <= pb_cheap THEN 1.5 * pb_weight
      WHEN price_to_book_pit <= pb_fair THEN 0.25 * pb_weight
      WHEN price_to_book_pit <= pb_expensive THEN -0.75 * pb_weight
      WHEN price_to_book_pit <= pb_extreme THEN -1.5 * pb_weight
      ELSE -2.25 * pb_weight
    END AS pb_score_pit,
    CASE
      WHEN asset_type IN ("ETF", "CRYPTO")
        OR NOT COALESCE(ttm_complete, FALSE)
        OR net_margin_ttm IS NULL
        OR profit_margin_weight = 0 THEN 0
      WHEN net_margin_ttm >= profit_margin_good THEN 1.0 * profit_margin_weight
      WHEN net_margin_ttm < profit_margin_bad THEN -1.0 * profit_margin_weight
      ELSE 0
    END AS net_margin_score_pit,
    CASE
      WHEN asset_type IN ("ETF", "CRYPTO")
        OR NOT COALESCE(ttm_complete, FALSE)
        OR operating_margin_ttm IS NULL
        OR operating_margin_weight = 0 THEN 0
      WHEN operating_margin_ttm >= operating_margin_good THEN 1.0 * operating_margin_weight
      WHEN operating_margin_ttm < operating_margin_bad THEN -1.0 * operating_margin_weight
      ELSE 0
    END AS operating_margin_score_pit
  FROM base
),
final AS (
  SELECT
    *,
    ROUND(
      pe_score_pit
      + ps_score_pit
      + pb_score_pit
      + net_margin_score_pit
      + operating_margin_score_pit,
      4
    ) AS valuation_score_pit
  FROM scored
)
SELECT
  *,
  CASE
    WHEN asset_type = "ETF" THEN "ETF_TRACKING_ONLY"
    WHEN asset_type = "CRYPTO" THEN "CRYPTO_TRACKING_ONLY"
    WHEN valuation_price IS NULL OR valuation_price_available_at IS NULL
      THEN "PIT_PRICE_UNAVAILABLE"
    WHEN reporting_currency IS NULL THEN "PIT_REPORTING_CURRENCY_UNKNOWN"
    WHEN reporting_currency != "USD" THEN "PIT_CURRENCY_CONVERSION_REQUIRED"
    WHEN NOT COALESCE(ttm_complete, FALSE) THEN "PIT_DATA_INCOMPLETE"
    WHEN pe_ttm_pit IS NULL
      AND price_to_sales_ttm_pit IS NULL
      AND price_to_book_pit IS NULL THEN "PIT_METRICS_UNAVAILABLE"
    WHEN valuation_score_pit >= 2 THEN "BARATA"
    WHEN valuation_score_pit >= 0 THEN "PRECIO_JUSTO"
    ELSE "CARA"
  END AS classification_pit,
  CASE
    WHEN valuation_price IS NULL OR valuation_price_available_at IS NULL
      THEN "MISSING_PRIOR_SESSION_PRICE"
    WHEN reporting_currency != "USD" THEN "FX_REQUIRED_NOT_AVAILABLE_IN_WP03"
    WHEN pe_ttm_pit IS NULL
      AND price_to_sales_ttm_pit IS NULL
      AND price_to_book_pit IS NULL THEN "NO_POSITIVE_DENOMINATOR_MULTIPLE"
    ELSE "PIT_VALUATION_INPUTS_AVAILABLE"
  END AS valuation_quality_status,
  "SHADOW_ONLY" AS promotion_mode,
  FALSE AS production_change_allowed,
  CURRENT_TIMESTAMP() AS calculated_at
FROM final
