config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v6_1_profile_backtest",
  description: "Backtest V6.1 por perfil independiente. Evita sumar capital de AAPL, META y BTC como si fueran una sola cartera.",
  tags: ["trading", "backtest", "v6_1", "experiment", "audit"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["profile_id", "ticker"] },
  assertions: { nonNull: ["profile_id", "analysis_date", "outcome_date", "paper_trade_id"], uniqueKey: ["profile_id", "paper_trade_id"] },
  dependencies: ["trading_directional_strategy_backtest", "trading_v6_1_profile_selection"]
}

SELECT
  s.profile_id,
  s.execution_lane,
  s.selection_status,
  s.rationale AS profile_rationale,
  CASE WHEN b.analysis_date < DATE "2025-01-01" THEN "TRAINING_TO_2024" ELSE "OUT_OF_SAMPLE_2025_ONWARD" END AS evaluation_period,
  b.*,
  "V6_1_PROFILED_V2_V3_SHADOW" AS portfolio_model,
  "Perfil independiente; no representa una cartera combinada ni autoriza ejecucion automatica." AS experiment_policy,
  CURRENT_TIMESTAMP() AS backtest_calculated_at
FROM ${ref("trading_directional_strategy_backtest")} b
JOIN ${ref("trading_v6_1_profile_selection")} s
  ON s.ticker = b.ticker
 AND s.strategy_version = b.strategy_version
WHERE b.outcome_date IS NOT NULL
  AND s.selection_status IN ("SELECTED_FOR_V6_1", "SHADOW_PENDING_OOS_SAMPLE")
