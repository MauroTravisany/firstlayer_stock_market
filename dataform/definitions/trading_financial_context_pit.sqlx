config {
  type: "table",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "trading_financial_context_pit",
  description: "Latest canonical fiscal quarter known at each signal timestamp, with same-quarter prior-year comparison over the already deduplicated PIT series.",
  tags: ["audit-grade", "pit", "financials", "backtest", "wp03"],
  bigquery: {
    partitionBy: "analysis_date",
    clusterBy: ["ticker"]
  },
  assertions: {
    nonNull: ["analysis_date", "signal_hour", "signal_timestamp", "ticker"],
    uniqueKey: ["analysis_date", "signal_hour", "ticker"],
    rowConditions: [
      "available_at IS NULL OR available_at <= signal_timestamp",
      "prior_year_available_at IS NULL OR prior_year_available_at <= signal_timestamp"
    ]
  },
  dependencies: ["financial_quarters_pit"]
}

WITH latest_quarter AS (
  SELECT * EXCEPT(latest_rank)
  FROM (
    SELECT
      q.*,
      ROW_NUMBER() OVER (
        PARTITION BY analysis_date, signal_hour, ticker
        ORDER BY fiscal_year DESC, fiscal_quarter DESC, period_end_date DESC, available_at DESC, revision_number DESC, revision_id DESC
      ) AS latest_rank
    FROM ${ref("financial_quarters_pit")} q
  )
  WHERE latest_rank = 1
),
latest_with_prior AS (
  SELECT
    current.*,
    prior.revision_id AS prior_year_revision_id,
    prior.revision_number AS prior_year_revision_number,
    prior.is_restated AS prior_year_is_restated,
    prior.available_at AS prior_year_available_at,
    prior.currency AS prior_year_currency,
    prior.quarter_value_basis AS prior_year_quarter_value_basis,
    prior.revenue AS revenue_same_q_prev_year,
    prior.net_income AS net_income_same_q_prev_year,
    ROW_NUMBER() OVER (
      PARTITION BY current.analysis_date, current.signal_hour, current.ticker
      ORDER BY prior.available_at DESC, prior.revision_number DESC, prior.revision_id DESC
    ) AS prior_rank
  FROM latest_quarter current
  LEFT JOIN ${ref("financial_quarters_pit")} prior
    ON prior.analysis_date = current.analysis_date
   AND prior.signal_hour = current.signal_hour
   AND prior.ticker = current.ticker
   AND prior.fiscal_year = current.fiscal_year - 1
   AND prior.fiscal_quarter = current.fiscal_quarter
   AND prior.currency = current.currency
)
SELECT
  analysis_date,
  signal_hour,
  signal_timestamp,
  ticker,
  revision_id,
  mapping_version,
  form_type,
  accession_number,
  revision_number,
  is_restated,
  fiscal_year,
  fiscal_quarter,
  quarter_value_basis,
  quarter_structure_complete,
  derivation_component_revision_ids,
  derivation_component_max_available_at,
  period_end_date,
  filing_date,
  source_published_at,
  available_at,
  currency,
  prior_year_revision_id,
  prior_year_revision_number,
  prior_year_is_restated,
  prior_year_available_at,
  prior_year_currency,
  prior_year_quarter_value_basis,
  revenue,
  revenue_same_q_prev_year,
  net_income,
  net_income_same_q_prev_year,
  gross_profit,
  operating_income,
  free_cash_flow,
  total_debt,
  shareholders_equity,
  CASE
    WHEN quarter_structure_complete
      AND revenue IS NOT NULL
      AND revenue_same_q_prev_year IS NOT NULL
      AND revenue_same_q_prev_year != 0
      THEN SAFE_DIVIDE(revenue - revenue_same_q_prev_year, ABS(revenue_same_q_prev_year))
    ELSE NULL
  END AS revenue_yoy,
  CASE
    WHEN quarter_structure_complete
      AND net_income IS NOT NULL
      AND net_income_same_q_prev_year IS NOT NULL
      AND net_income_same_q_prev_year != 0
      THEN SAFE_DIVIDE(net_income - net_income_same_q_prev_year, ABS(net_income_same_q_prev_year))
    ELSE NULL
  END AS net_income_yoy,
  SAFE_DIVIDE(net_income, NULLIF(revenue, 0)) AS net_margin_asof,
  SAFE_DIVIDE(free_cash_flow, NULLIF(revenue, 0)) AS fcf_margin_asof,
  SAFE_DIVIDE(total_debt, NULLIF(shareholders_equity, 0)) AS debt_to_equity_asof
FROM latest_with_prior
WHERE prior_rank = 1
