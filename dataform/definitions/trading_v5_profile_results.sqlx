config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v5_profile_results",
  description: "Resultados V5P con reglas independientes por perfil de activo. Experimento aislado de backtesting.",
  tags: ["trading", "backtest", "v5_profile", "experiment", "daily"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["asset_rule_profile", "ticker", "trade_status"] },
  assertions: { nonNull: ["analysis_date", "ticker", "v5p_trade_id", "outcome_date", "asset_rule_profile"], uniqueKey: ["v5p_trade_id"] },
  dependencies: ["trading_structural_backtest_results", "trading_price_features", "trading_v5_profile_config", "trading_v5_profile_asset_rules"]
}

WITH config_values AS (
  SELECT * FROM ${ref("trading_v5_profile_config")}
), profiled AS (
  SELECT
    s.*,
    c.experiment_id,
    c.initial_capital_clp,
    c.max_entries_per_day,
    c.max_entries_per_profile_per_day,
    CASE
      WHEN s.asset_type = "CRYPTO" AND s.cycle_profile LIKE "%BTC%" THEN "CRYPTO_BTC"
      WHEN s.asset_type = "CRYPTO" THEN "CRYPTO_ETH"
      WHEN s.trading_group = "crypto_sensitive_stock" THEN "CRYPTO_LINKED_EQUITY"
      WHEN s.trading_group = "high_beta_stock" THEN "SEMICONDUCTOR_AI"
      WHEN s.sector_profile = "Digital advertising/AI" THEN "DIGITAL_ADVERTISING_AI"
      WHEN s.trading_group = "mega_cap_stock" THEN "TECH_MEGACAP"
      ELSE "DEFENSIVE_OR_ETF"
    END AS asset_rule_profile
  FROM ${ref("trading_structural_backtest_results")} s
  CROSS JOIN config_values c
  WHERE s.strategy_version = "v2"
    AND s.trade_status != "OPEN"
), qualified AS (
  SELECT
    p.*,
    r.rule_rationale AS asset_rule_rationale,
    r.stop_distance_multiplier,
    r.take_profit_r,
    r.max_holding_days AS v5p_max_holding_days,
    r.max_position_pct AS v5p_max_position_pct
  FROM profiled p
  JOIN ${ref("trading_v5_profile_asset_rules")} r USING (asset_rule_profile)
  WHERE p.contextual_setup_score >= r.min_setup_score
    AND p.contextual_technical_score >= r.min_technical_score
    AND p.trend_score >= r.min_trend_score
    AND (NOT r.require_positive_macro OR p.macro_alignment_score >= 0)
    AND (NOT r.block_earnings_risk OR COALESCE(p.earnings_event_status, "") != "EARNINGS_RISK")
    AND (NOT r.require_crypto_strength OR COALESCE(p.crypto_context_regime, "") != "CRYPTO_DEBIL")
), ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY analysis_date
      ORDER BY contextual_setup_score DESC, contextual_technical_score DESC, trend_score DESC, ticker
    ) AS daily_rank,
    ROW_NUMBER() OVER (
      PARTITION BY analysis_date, asset_rule_profile
      ORDER BY contextual_setup_score DESC, contextual_technical_score DESC, trend_score DESC, ticker
    ) AS profile_daily_rank
  FROM qualified
), selected_candidates AS (
  SELECT
    *,
    TO_HEX(SHA256(CONCAT(structural_trade_id, "|", experiment_id, "|", asset_rule_profile))) AS v5p_trade_id,
    GREATEST(
      SAFE_DIVIDE(theoretical_entry_price - adaptive_stop_loss, theoretical_entry_price) * stop_distance_multiplier,
      IF(asset_type = "CRYPTO", 0.035, 0.02)
    ) AS v5p_stop_distance,
    ROUND(LEAST(initial_capital_clp * v5p_max_position_pct, adaptive_position_notional_clp), 0) AS position_notional_clp
  FROM ranked
  WHERE daily_rank <= max_entries_per_day
    AND profile_daily_rank <= max_entries_per_profile_per_day
), prepared_trades AS (
  SELECT
    *,
    ROUND(theoretical_entry_price * (1 - v5p_stop_distance), 4) AS stop_loss,
    ROUND(theoretical_entry_price * (1 + v5p_stop_distance * take_profit_r + estimated_roundtrip_cost_pct / 100), 4) AS take_profit
  FROM selected_candidates
), future_candidates AS (
  SELECT
    t.v5p_trade_id,
    t.v5p_max_holding_days,
    p.analysis_date AS path_date,
    p.day_low,
    p.day_high,
    p.day_close,
    CASE WHEN p.day_low <= t.stop_loss THEN "STOP_LOSS" WHEN p.day_high >= t.take_profit THEN "TAKE_PROFIT" END AS event_type,
    CASE WHEN p.day_low <= t.stop_loss THEN t.stop_loss WHEN p.day_high >= t.take_profit THEN t.take_profit END AS event_price,
    CASE WHEN p.day_low <= t.stop_loss THEN 1 WHEN p.day_high >= t.take_profit THEN 2 ELSE 9 END AS event_priority
  FROM prepared_trades t
  JOIN ${ref("trading_price_features")} p
    ON p.ticker = t.ticker
   AND p.signal_timestamp > t.signal_timestamp
   AND p.signal_timestamp <= DATETIME_ADD(t.signal_timestamp, INTERVAL 30 DAY)
), future_path AS (
  SELECT * EXCEPT (future_bar_number)
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY v5p_trade_id ORDER BY path_date) AS future_bar_number
    FROM future_candidates
  )
  WHERE future_bar_number <= v5p_max_holding_days
), first_event AS (
  SELECT
    v5p_trade_id,
    ARRAY_AGG(IF(event_type IS NOT NULL, STRUCT(path_date, event_type, event_price, event_priority), NULL) IGNORE NULLS ORDER BY path_date, event_priority LIMIT 1)[SAFE_OFFSET(0)] AS first_hit,
    ARRAY_AGG(STRUCT(path_date, day_close) ORDER BY path_date DESC LIMIT 1)[SAFE_OFFSET(0)] AS latest_seen,
    COUNT(*) AS future_days_seen
  FROM future_path
  GROUP BY v5p_trade_id
), evaluated AS (
  SELECT
    t.* EXCEPT (outcome_date, future_days_seen, trade_status, exit_price),
    fe.future_days_seen,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.path_date ELSE fe.latest_seen.path_date END AS outcome_date,
    CASE WHEN fe.first_hit.event_type IS NOT NULL THEN fe.first_hit.event_type ELSE "TIME_EXIT" END AS trade_status,
    CASE WHEN fe.first_hit.event_price IS NOT NULL THEN fe.first_hit.event_price ELSE fe.latest_seen.day_close END AS exit_price
  FROM prepared_trades t
  JOIN first_event fe USING (v5p_trade_id)
)

SELECT
  experiment_id, benchmark_candidate_id, v5p_trade_id, structural_trade_id,
  analysis_date, signal_timestamp, outcome_date, ticker, asset_type, trading_group, sector_profile, cycle_profile,
  asset_rule_profile, asset_rule_rationale, daily_rank, profile_daily_rank,
  contextual_setup_score AS setup_score, contextual_technical_score AS technical_score, trend_score, momentum_score, volume_score,
  macro_alignment_score, factor_alignment_score, historical_fear_regime, crypto_context_regime, earnings_event_status,
  theoretical_entry_price, stop_loss, take_profit, v5p_stop_distance, v5p_max_holding_days, future_days_seen,
  estimated_roundtrip_cost_pct, position_notional_clp, trade_status, exit_price,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price), 4) AS gross_return_pct,
  ROUND(SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - estimated_roundtrip_cost_pct / 100, 4) AS net_return_pct,
  ROUND(position_notional_clp * (SAFE_DIVIDE(exit_price - theoretical_entry_price, theoretical_entry_price) - estimated_roundtrip_cost_pct / 100), 0) AS net_pnl_clp,
  exit_price > theoretical_entry_price * (1 + estimated_roundtrip_cost_pct / 100) AS is_win,
  CURRENT_TIMESTAMP() AS calculated_at
FROM evaluated

