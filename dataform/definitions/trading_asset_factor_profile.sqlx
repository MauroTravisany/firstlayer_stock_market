  ,STRUCT("JNJ", "STOCK", "Diversified healthcare", "DEFENSIVE_HEALTHCARE", "Salud diversificada; demanda relativamente estable y riesgos regulatorios/patentes.", "Farmaceutica, tecnologia medica y salud", "Litigios, regulacion, patentes y ejecucion de cartera", 0.00, 0.05, 0.10, 0.00, 0.00, 0.00, 0.25, 0.25, 0.10, 0.25, 0.00, 0.00, 0.50, 0.65, 0.75, 0.85, 0.70)
