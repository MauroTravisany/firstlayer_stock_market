  ,STRUCT("KO", "STOCK", "Consumer staples beverages", "DEFENSIVE_CONSUMER_STAPLES", "Marcas de bebidas y demanda recurrente; importan dolar, insumos y volumen global.", "Consumo cotidiano y distribucion global", "Dolar fuerte, costos de insumos, regulacion y desaceleracion emergente", 0.00, 0.00, 0.30, 0.00, 0.10, 0.00, 0.30, 0.50, 0.05, 0.25, 0.00, 0.00, 0.20, 0.65, 0.75, 0.80, 0.70)
