  ,STRUCT("PG", "STOCK", "Consumer staples household", "DEFENSIVE_CONSUMER_STAPLES", "Productos de cuidado personal y hogar con demanda recurrente.", "Volumen, precio y marcas de consumo cotidiano", "Dolar, materias primas, competencia y volumen debil", 0.00, 0.00, 0.30, 0.00, 0.10, 0.00, 0.30, 0.55, 0.05, 0.25, 0.00, 0.00, 0.15, 0.65, 0.75, 0.85, 0.70)
  ,STRUCT("PEP", "STOCK", "Consumer staples beverages and snacks", "DEFENSIVE_CONSUMER_STAPLES", "Bebidas y snacks con demanda recurrente y distribucion global.", "Volumen, precio y marcas de consumo cotidiano", "Dolar, insumos, regulacion y desaceleracion de volumen", 0.00, 0.00, 0.35, 0.00, 0.15, 0.00, 0.30, 0.50, 0.05, 0.25, 0.00, 0.00, 0.15, 0.65, 0.75, 0.80, 0.70)
  ,STRUCT("WMT", "STOCK", "Essential retail", "DEFENSIVE_RETAIL", "Retail de escala con consumo esencial, tienda, ecommerce y membresias.", "Consumo basico, cuota de mercado y eficiencia operativa", "Presion de margenes, salarios, inventario y menor consumo", 0.00, 0.10, 0.55, 0.00, 0.00, 0.00, 0.35, 0.25, 0.05, 0.35, 0.00, 0.00, 0.15, 0.80, 0.90, 0.70, 0.85)
