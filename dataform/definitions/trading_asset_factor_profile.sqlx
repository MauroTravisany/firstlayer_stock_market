  ,STRUCT("MA", "STOCK", "Global payment network", "QUALITY_PAYMENT_NETWORK", "Red de pagos sin riesgo crediticio directo; importa el volumen transaccional global.", "Consumo, viajes y pagos digitales", "Desaceleracion consumo, regulacion y competencia", 0.00, 0.10, 0.65, 0.00, 0.00, 0.00, 0.55, 0.35, 0.05, 0.55, 0.00, 0.00, 0.40, 0.85, 0.90, 0.60, 0.85)
])
