config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v6_conservative_candidate_screen",
  description: "Pantalla auditable de candidatos conservadores para V6.1. Selecciona con entrenamiento hasta 2024 y validacion 2025; desde 2026 queda como prueba final independiente.",
  tags: ["trading", "backtest", "v6_candidate", "experiment", "audit"],
  bigquery: { clusterBy: ["ticker", "strategy_version", "candidate_status"] },
  assertions: { nonNull: ["ticker", "strategy_version", "candidate_status"], uniqueKey: ["ticker", "strategy_version"] },
  dependencies: ["trading_v6_conservative_candidate_backtest"]
}

WITH period_metrics AS (
  SELECT
    b.ticker,
    b.strategy_version,
    CASE
      WHEN b.analysis_date < DATE "2025-01-01" THEN "TRAINING_TO_2024"
      WHEN b.analysis_date < DATE "2026-01-01" THEN "VALIDATION_2025"
      ELSE "FINAL_TEST_2026_ONWARD"
    END AS evaluation_period,
    COUNT(*) AS closed_trades,
    COUNTIF(b.is_win) AS wins,
    ROUND(SUM(b.net_pnl_clp), 0) AS net_pnl_clp,
    ROUND(SAFE_DIVIDE(SUM(IF(b.net_pnl_clp > 0, b.net_pnl_clp, 0)), ABS(SUM(IF(b.net_pnl_clp < 0, b.net_pnl_clp, 0)))), 3) AS profit_factor
  FROM ${ref("trading_v6_conservative_candidate_backtest")} b
  WHERE b.outcome_date IS NOT NULL
  GROUP BY b.ticker, b.strategy_version, evaluation_period
), pivoted AS (
  SELECT
    ticker,
    strategy_version,
    COALESCE(MAX(IF(evaluation_period = "TRAINING_TO_2024", closed_trades, NULL)), 0) AS training_closed_trades,
    COALESCE(MAX(IF(evaluation_period = "TRAINING_TO_2024", wins, NULL)), 0) AS training_wins,
    COALESCE(MAX(IF(evaluation_period = "TRAINING_TO_2024", net_pnl_clp, NULL)), 0) AS training_net_pnl_clp,
    COALESCE(MAX(IF(evaluation_period = "TRAINING_TO_2024", profit_factor, NULL)), 0) AS training_profit_factor,
    COALESCE(MAX(IF(evaluation_period = "VALIDATION_2025", closed_trades, NULL)), 0) AS validation_closed_trades,
    COALESCE(MAX(IF(evaluation_period = "VALIDATION_2025", wins, NULL)), 0) AS validation_wins,
    COALESCE(MAX(IF(evaluation_period = "VALIDATION_2025", net_pnl_clp, NULL)), 0) AS validation_net_pnl_clp,
    COALESCE(MAX(IF(evaluation_period = "VALIDATION_2025", profit_factor, NULL)), 0) AS validation_profit_factor,
    COALESCE(MAX(IF(evaluation_period = "FINAL_TEST_2026_ONWARD", closed_trades, NULL)), 0) AS final_test_closed_trades,
    COALESCE(MAX(IF(evaluation_period = "FINAL_TEST_2026_ONWARD", wins, NULL)), 0) AS final_test_wins,
    COALESCE(MAX(IF(evaluation_period = "FINAL_TEST_2026_ONWARD", net_pnl_clp, NULL)), 0) AS final_test_net_pnl_clp,
    COALESCE(MAX(IF(evaluation_period = "FINAL_TEST_2026_ONWARD", profit_factor, NULL)), 0) AS final_test_profit_factor
  FROM period_metrics
  GROUP BY ticker, strategy_version
)

SELECT
  *,
  ROUND(SAFE_DIVIDE(training_wins, training_closed_trades) * 100, 2) AS training_win_rate_pct,
  ROUND(SAFE_DIVIDE(validation_wins, validation_closed_trades) * 100, 2) AS validation_win_rate_pct,
  ROUND(SAFE_DIVIDE(final_test_wins, final_test_closed_trades) * 100, 2) AS final_test_win_rate_pct,
  CASE
    WHEN training_closed_trades >= 10
      AND training_net_pnl_clp > 0
      AND training_profit_factor >= 1.10
      AND validation_closed_trades >= 5
      AND validation_net_pnl_clp > 0
      AND validation_profit_factor >= 1.10 THEN "VALIDATION_PASSED_FINAL_TEST_PENDING"
    WHEN training_closed_trades >= 10
      AND training_net_pnl_clp > 0
      AND training_profit_factor >= 1.10
      AND validation_closed_trades < 5 THEN "SHADOW_PENDING_VALIDATION_SAMPLE"
    WHEN training_closed_trades >= 10
      AND training_net_pnl_clp > 0
      AND training_profit_factor >= 1.10 THEN "VALIDATION_REJECTED"
    ELSE "INSUFFICIENT_OR_UNPROVEN"
  END AS candidate_status,
  "La seleccion usa entrenamiento hasta 2024 y validacion 2025. Desde 2026 es prueba final bloqueada. Esta tabla no agrega ningun ticker a V6.1 ni a Alpaca." AS safety_policy,
  CURRENT_TIMESTAMP() AS calculated_at
FROM pivoted
