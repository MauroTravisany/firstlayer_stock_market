config {
  type: "table",
  schema: "acciones_dataset",
  name: "trading_v5_high_turnover_portfolio",
  description: "Cartera V5 de hasta ocho posiciones concurrentes por lote. Los ciclos de 16 dias evitan solapamientos y no duplican capital.",
  tags: ["trading", "backtest", "v5", "experiment", "daily"],
  bigquery: { partitionBy: "analysis_date", clusterBy: ["portfolio_slot", "ticker"] },
  assertions: {
    nonNull: ["v5_trade_id", "portfolio_slot", "outcome_date"],
    uniqueKey: ["v5_trade_id"]
  },
  dependencies: ["trading_v5_high_turnover_results", "trading_v5_high_turnover_config"]
}

-- A fixed 16-day batch is deliberately longer than the maximum five-trading-day
-- holding period. Even if the first available signal is late in a batch, the next
-- batch begins at least nine calendar days later, so positions cannot overlap.
WITH candidates AS (
  SELECT
    r.* EXCEPT (batch_number, batch_start_date),
    c.initial_capital_clp,
    c.batch_cycle_days,
    DIV(DATE_DIFF(r.analysis_date, DATE "2019-01-01", DAY), c.batch_cycle_days) AS batch_number,
    MOD(DATE_DIFF(r.analysis_date, DATE "2019-01-01", DAY), c.batch_cycle_days) AS batch_day_offset
  FROM ${ref("trading_v5_high_turnover_results")} r
  CROSS JOIN ${ref("trading_v5_high_turnover_config")} c
), daily_batches AS (
  SELECT
    batch_number,
    MIN(analysis_date) AS batch_start_date
  FROM candidates
  WHERE batch_day_offset < 8
  GROUP BY batch_number
)

SELECT
  c.*,
  c.daily_rank AS portfolio_slot,
  d.batch_start_date,
  "CONCURRENT_EIGHT_BATCH" AS portfolio_model,
  CURRENT_TIMESTAMP() AS portfolio_calculated_at
FROM daily_batches d
JOIN candidates c
  ON c.batch_number = d.batch_number
 AND c.analysis_date = d.batch_start_date
