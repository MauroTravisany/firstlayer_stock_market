config {
  type: "view",
  schema: dataform.projectConfig.vars.auditDataset,
  name: "financial_statements_pit",
  description: "Canonical eligible SEC filing revisions pinned to one declared ticker/CIK/currency mapping version. Revision ordinals and restatement flags are derived over the complete immutable source history for that mapping.",
  tags: ["audit-grade", "pit", "financials", "wp03"],
  assertions: {
    nonNull: ["revision_id", "ticker", "mapping_version", "source_record_id", "source_is_amendment", "revision_number", "is_restated", "period_end_date", "source_published_at", "available_at", "eligibility_reason", "quality_status"],
    uniqueKey: ["revision_id"],
    rowConditions: [
      "backtest_eligible = TRUE",
      "available_at = source_published_at",
      "revision_number > 0",
      "quality_status = 'ELIGIBLE_VERIFIED_PIT'"
    ]
  },
  dependencies: ["financial_statements_pit_raw"]
}

WITH eligible_raw AS (
  SELECT *
  FROM ${ref("financial_statements_pit_raw")}
  WHERE mapping_version = "${dataform.projectConfig.vars.financialMappingVersion}"
    AND backtest_eligible = TRUE
    AND available_at IS NOT NULL
    AND source_published_at IS NOT NULL
    AND quality_status = "ELIGIBLE_VERIFIED_PIT"
),
versioned AS (
  SELECT
    raw.*,
    ROW_NUMBER() OVER (
      PARTITION BY ticker, fiscal_year, fiscal_quarter
      ORDER BY available_at, filing_date, source_record_id, revision_id
    ) AS revision_number
  FROM eligible_raw raw
)
SELECT
  revision_id,
  ticker,
  cik,
  mapping_version,
  form_type,
  accession_number,
  source_record_id,
  source_is_amendment,
  revision_number,
  source_is_amendment OR revision_number > 1 AS is_restated,
  filing_date,
  source_published_at,
  available_at,
  period_end_date,
  fiscal_year,
  fiscal_quarter,
  currency,
  revenue,
  gross_profit,
  operating_income,
  net_income,
  eps_basic,
  eps_diluted,
  total_assets,
  total_liabilities,
  total_debt,
  debt_current,
  debt_noncurrent,
  cash_and_equivalents,
  shares_outstanding,
  shareholders_equity,
  operating_cash_flow,
  free_cash_flow,
  source,
  source_url,
  backtest_eligible,
  eligibility_reason,
  quality_status,
  loaded_at
FROM versioned
